# Fedora-native AppImage build environment.
#
# This produces the Fedora variant: it is built against Fedora's glibc and Tk,
# so it is intended for current Fedora systems.  For the portable artifact use
# Dockerfile (Ubuntu 24.04) instead.
#
#   docker build -f packaging/Dockerfile.fedora -t live-caption-build:fedora packaging
#
# Pinned to Fedora 44 on purpose.  It ships Python 3.14, for which sherpa-onnx
# publishes wheels.  A newer Fedora may ship a Python version without a wheel,
# and pip would then try (and fail) to compile sherpa-onnx from source.
FROM fedora:44

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# python3-devel provides the shared libpython that PyInstaller needs.
# python3-pip makes `python3 -m venv` able to bootstrap pip in the container.
# pulseaudio-libs provides libpulse-simple.so.0 used by audio_capture.py.
# libgomp is needed by the sherpa-onnx/onnxruntime wheels.
RUN dnf install -y --setopt=install_weak_deps=False \
        python3 python3-devel python3-pip python3-tkinter \
        pulseaudio-libs libgomp \
        zsync file git curl ca-certificates \
        desktop-file-utils binutils \
    && dnf clean all

WORKDIR /src
