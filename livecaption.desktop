[Desktop Entry]
Name=LiveCaption Translator
Comment=Live captioning and translation
Exec=/home/username/livecaption/launcher.sh
Terminal=false
Type=Application
Categories=Utility;Accessibility;
Icon=audio-input-microphone
Actions=zh_en;

[Desktop Action zh_en]
Name=zh -> en
Exec=/home/username/livecaption/launcher.sh zh en
